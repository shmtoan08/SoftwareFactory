{
  "name": "@software-factory/monorepo",
  "version": "1.5.0",
  "private": true,
  "description": "Software Factory v1.5 \u2014 Control Plane, Agent Gateway, Managed Linux Worker, and Verification/Merge Pipeline",
  "type": "module",
  "engineStrict": true,
  "engines": {
    "node": ">=22.6.0"
  },
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "lint": "node scripts/ci/lint.mjs",
    "scan:secrets": "node scripts/ci/secret-scan.mjs",
    "start:core-api": "node apps/core-api/src/main.ts",
    "start:gateway": "node apps/agent-gateway/src/main.ts",
    "start:web": "node apps/web/src/main.ts",
    "test": "node --test --test-concurrency=1 packages/test-harness/src/m1-acceptance.test.ts packages/test-harness/src/m2-acceptance.test.ts packages/test-harness/src/m3-acceptance.test.ts packages/test-harness/src/m4-acceptance.test.ts packages/test-harness/src/m5-acceptance.test.ts packages/test-harness/src/m6a-acceptance.test.ts packages/test-harness/src/m6b-acceptance.test.ts packages/test-harness/src/m6c-acceptance.test.ts packages/test-harness/src/m6c-import-adapters.test.ts packages/test-harness/src/m6c-review-fixes.test.ts",
    "test:m1": "node --test packages/test-harness/src/m1-acceptance.test.ts",
    "test:m2": "node --test packages/test-harness/src/m2-acceptance.test.ts",
    "test:m3": "node --test packages/test-harness/src/m3-acceptance.test.ts",
    "test:m4": "node --test packages/test-harness/src/m4-acceptance.test.ts",
    "test:m5": "node --test packages/test-harness/src/m5-acceptance.test.ts",
    "test:m6a": "node --test packages/test-harness/src/m6a-acceptance.test.ts",
    "test:m6b": "node --test packages/test-harness/src/m6b-acceptance.test.ts",
    "test:all": "node --test --test-concurrency=1 packages/*/src/*.test.ts packages/test-harness/src/*.test.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test:m6c": "node --test packages/test-harness/src/m6c-acceptance.test.ts",
    "test:m6c2": "node --test packages/test-harness/src/m6c-import-adapters.test.ts",
    "test:m6c:fix": "node --test packages/test-harness/src/m6c-review-fixes.test.ts"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "typescript": "^5.6.3"
  }
}
