{
  "name": "@software-factory/monorepo",
  "version": "1.5.0",
  "private": true,
  "description": "Software Factory v1.5 — Control Plane, Agent Gateway, Managed Linux Worker, and Verification/Merge Pipeline",
  "type": "module",
  "engineStrict": true,
  "engines": {
    "node": ">=22.6.0"
  },
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "lint": "node scripts/ci/lint.mjs",
    "scan:secrets": "node scripts/ci/secret-scan.mjs",
    "test": "node --test packages/test-harness/src/m1-acceptance.test.ts packages/test-harness/src/m2-acceptance.test.ts",
    "test:m1": "node --test packages/test-harness/src/m1-acceptance.test.ts",
    "test:m2": "node --test packages/test-harness/src/m2-acceptance.test.ts",
    "test:all": "node --test packages/*/src/*.test.ts packages/test-harness/src/*.test.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "typescript": "^5.6.3"
  }
}
