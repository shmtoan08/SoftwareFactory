{
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    "noEmit": true,
    "allowImportingTsExtensions": true,
    "declaration": false,
    "declarationMap": false,
    "sourceMap": false,
    "baseUrl": ".",
    "paths": {
      "@software-factory/shared-types": ["packages/shared-types/src/index.ts"],
      "@software-factory/task-contract": ["packages/task-contract/src/index.ts"],
      "@software-factory/adapter-sdk": ["packages/adapter-sdk/src/index.ts"],
      "@software-factory/database": ["packages/database/src/index.ts"],
      "@software-factory/wna": ["packages/wna/src/index.ts"],
      "@software-factory/verifier": ["packages/verifier/src/index.ts"],
      "@software-factory/reviewer": ["packages/reviewer/src/index.ts"],
      "@software-factory/product-pipeline": ["packages/product-pipeline/src/index.ts"],
      "@software-factory/core-api": ["apps/core-api/src/index.ts"],
      "@software-factory/agent-gateway": ["apps/agent-gateway/src/index.ts"],
      "@software-factory/web": ["apps/web/src/index.ts"]
    }
  },
  "include": [
    "apps/*/src/**/*.ts",
    "packages/*/src/**/*.ts"
  ],
  "exclude": [
    "node_modules",
    "**/dist"
  ]
}
